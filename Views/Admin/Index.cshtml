@model IEnumerable<EventDto>

@{
    ViewData["Title"] = "Organiser Dashboard";
    var events = Model?.ToList() ?? new List<EventDto>();
    var totalEvents = events.Count;
    var upcomingEvents = events.Where(e => e.Date >= DateTime.Now).OrderBy(e => e.Date).ToList();
    var totalEnrolments = events.Sum(e => e.EnrolmentCount);
    var next = upcomingEvents.FirstOrDefault();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h2 class="rd-title">Organiser Dashboard</h2>
    <a asp-controller="Admin" asp-action="CreateEvent" class="btn btn-primary btn-lg shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Create New Event
    </a>
</div>

<!-- Summary tiles -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-tile stat-navy">
            <div class="label">Total Events</div>
            <div class="value">@totalEvents</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-tile stat-green">
            <div class="label">Upcoming Races</div>
            <div class="value">@upcomingEvents.Count</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-tile stat-orange">
            <div class="label">Total Enrolments</div>
            <div class="value">@totalEnrolments</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-tile stat-slate">
            <div class="label">Next Race</div>
            <div class="fs-4 fw-bold text-truncate">@(next?.Name ?? "None scheduled")</div>
            <small class="opacity-75">@(next?.Date.ToString("MMM dd, yyyy") ?? "-")</small>
        </div>
    </div>
</div>

<!-- Event management -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0">Your Events</h5>
    </div>
    <div class="card-body p-0">
        @if (!events.Any())
        {
            <div class="text-center py-5 empty-state">
                <i class="bi bi-calendar-plus"></i>
                <p class="text-muted my-3">You have not created any events yet.</p>
                <a asp-controller="Admin" asp-action="CreateEvent" class="btn btn-outline-primary">Create Your First Event</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Type</th>
                            <th class="text-center">Enrolments</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var race in events)
                        {
                            <tr>
                                <td class="fw-semibold">@race.Name</td>
                                <td>@race.Date.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>@race.Location</td>
                                <td>
                                    <span class="badge bg-secondary">@race.Distance</span>
                                    <span class="badge bg-info text-dark">@race.EventType</span>
                                </td>
                                <td class="text-center"><span class="badge bg-primary rounded-pill fs-6">@race.EnrolmentCount</span></td>
                                <td class="text-end rd-actions">
                                    <a asp-action="EditEvent" asp-route-id="@race.Id" class="btn btn-sm btn-outline-secondary mb-1"><i class="bi bi-pencil"></i> Edit</a>
                                    <a asp-action="ManageCategories" asp-route-id="@race.Id" class="btn btn-sm btn-outline-dark mb-1"><i class="bi bi-tags"></i> Categories</a>
                                    <a asp-action="ViewEnrolments" asp-route-id="@race.Id" class="btn btn-sm btn-outline-info mb-1"><i class="bi bi-people"></i> Enrolments</a>
                                    <a asp-action="EnterResults" asp-route-id="@race.Id" class="btn btn-sm btn-outline-success mb-1"><i class="bi bi-stopwatch"></i> Results</a>
                                    <form asp-action="DeleteEvent" asp-route-id="@race.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this event, its categories, enrolments and results? This cannot be undone.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger mb-1"><i class="bi bi-trash"></i> Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
