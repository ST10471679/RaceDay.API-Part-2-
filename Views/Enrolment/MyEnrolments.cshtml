@model IEnumerable<RaceDay.Web.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<h2 class="rd-title mb-4">My Enrolled Events</h2>

@if (Model == null || !Model.Any())
{
    <div class="card border-0 shadow-sm text-center py-5 empty-state">
        <div class="card-body">
            <i class="bi bi-ticket-perforated"></i>
            <h4 class="mt-3">No Enrolments Found</h4>
            <p class="text-muted">You haven't signed up for any events yet.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Browse Events</a>
        </div>
    </div>
}
else
{
    <div class="table-responsive card border-0 shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Event</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Enrolled On</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var badgeClass = item.Status == "Confirmed" ? "bg-success" :
                                     item.Status == "Pending" ? "bg-warning text-dark" : "bg-secondary";
                    <tr>
                        <td>
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@item.EventId" class="fw-semibold text-decoration-none">@item.EventName</a>
                            <div class="small text-muted"><i class="bi bi-geo-alt"></i> @item.Location</div>
                        </td>
                        <td><span class="badge bg-secondary">@item.CategoryName</span></td>
                        <td>@item.EventDate.ToString("MMM dd, yyyy @ HH:mm")</td>
                        <td>@item.EnrolmentDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge @badgeClass">@(item.Status == "Pending" ? "Waiting list" : item.Status)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
