@model IEnumerable<ParticipantResultDto>

@{
    ViewData["Title"] = "My Results";
}

<h2 class="rd-title mb-4">My Race History &amp; Results</h2>

@if (Model == null || !Model.Any())
{
    <div class="card border-0 shadow-sm text-center py-5 empty-state">
        <div class="card-body">
            <i class="bi bi-trophy"></i>
            <h4 class="mt-3">No Race Results Yet</h4>
            <p class="text-muted mb-0">Once an organiser publishes the results of a race you entered, your time and position will appear here.</p>
        </div>
    </div>
}
else
{
    <div class="table-responsive card border-0 shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Finish Time</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var podium = item.Position is >= 1 and <= 3 ? $"rd-podium-{item.Position}" : "";
                    <tr>
                        <td class="fw-semibold">@item.EventName</td>
                        <td>@item.EventDate.ToString("MMM dd, yyyy")</td>
                        <td><span class="badge bg-secondary">@item.CategoryName</span></td>
                        <td class="rd-time">@(string.IsNullOrEmpty(item.FinishTime) ? "N/A" : item.FinishTime)</td>
                        <td>
                            @if (item.Position > 0)
                            {
                                <span class="rd-place @podium">
                                    @if (item.Position <= 3) { <i class="bi bi-trophy-fill"></i> }
                                    @Ordinal.Of(item.Position)
                                </span>
                                @if (item.TotalFinishers > 0)
                                {
                                    <span class="text-muted"> out of @item.TotalFinishers finishers</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Pending</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
